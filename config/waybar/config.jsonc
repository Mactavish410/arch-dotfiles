{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "hyprland/language",
        "custom/gpu",
        "cpu",
        "memory",
        "custom/docker",
        "custom/ollama",
        "pulseaudio",
        "tray"
    ],
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU",
        "keyboard-name": "at-translated-set-2-keyboard"
    },
    "clock": {
        "interval": 1,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "format": {
                "months": "<span color='#00f0ff'><b>{}</b></span>",
                "days": "<span color='#e8f0ff'>{}</span>",
                "weeks": "<span color='#8a9bb0'><b>W{}</b></span>",
                "weekdays": "<span color='#ff2a6d'><b>{}</b></span>",
                "today": "<span color='#fcee0a'><b><u>{}</u></b></span>"
            }
        }
    },
    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%",
        "tooltip": true
    },
    "memory": {
        "interval": 2,
        "format": "RAM {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },
    "custom/gpu": {
        "exec": "$HOME/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 3,
        "format": "{}",
        "tooltip": true
    },
    "custom/docker": {
        "exec": "$HOME/.config/waybar/scripts/docker.sh",
        "return-type": "json",
        "interval": 10,
        "format": "{}",
        "tooltip": true
    },
    "custom/ollama": {
        "exec": "$HOME/.config/waybar/scripts/ollama.sh",
        "return-type": "json",
        "interval": 15,
        "format": "{}",
        "tooltip": true
    },
    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} {title}",
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 40,
        "tooltip-format": "{artist} — {title}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "tooltip": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
