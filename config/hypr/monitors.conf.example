# 3-monitor desktop layout — copy over monitors.conf after checking `hyprctl monitors`
# DP-1 primary landscape @144Hz
# DP-2 portrait (transform 1) to the left
# HDMI-A-1 to the right of DP-1, vertically offset

monitor = DP-1, 1920x1080@144, 0x0, 1
monitor = DP-2, 1920x1080@60, -1080x0, 1, transform, 1
monitor = HDMI-A-1, 1920x1080@60, 1920x200, 1

workspace = 1, monitor:DP-1, default:true
workspace = 2, monitor:DP-2, default:true
workspace = 3, monitor:HDMI-A-1, default:true
